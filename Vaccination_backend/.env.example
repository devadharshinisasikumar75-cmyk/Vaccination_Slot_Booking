# Brevo > Settings > SMTP & API > API keys
BREVO_API_KEY=

# Brevo-verified sender address
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VaxCare

# Use a long, random secret for HMAC-protected OTP storage
OTP_HMAC_SECRET=

# Generate a separate random secret of at least 32 bytes for bearer-token signing
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

# Optional: creates the first ADMIN account on backend startup if no ADMIN exists.
# Remove both values from .env after the account is created.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Local database by default. For Railway, set DB_URL to the Railway MySQL JDBC URL.
DB_URL=jdbc:mysql://localhost:3306/vaxcare_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated exact browser origins; use the deployed frontend URL on Railway.
CORS_ALLOWED_ORIGINS=http://localhost:5173
